# --- System & Temp Files ---
.DS_Store
*.swp
*.tmp
.netrc

# --- SSH Secrets (CRITICAL) ---
# We want to track the config file, but NOT the keys
ssh/.ssh/*
!ssh/.ssh/config

# --- Sensitive Shell Files ---
# History often contains passwords or API keys typed by mistake
bash/.bash_history
zsh/.zsh_history
.python_history

# --- GPG / Secret Keys ---
*.gpg
*.asc
*.key
*.pem

# --- Local Overrides ---
# Sometimes you want a .bashrc.local for one specific machine.
# NOTE: bare "*.local" also matches a directory literally named ".local",
# which swallows every stow package's "<pkg>/.local/..." tree (bin/, share/
# fonts/, etc). The negations below carve those back out.
*.local
!**/.local/
!**/.local/**
