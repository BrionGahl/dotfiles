# Dracula theme, matching alacritty/.alacritty.toml and waybar/.config/waybar/style.css:
# same background (opacity raised to 0.92 to cut down how much blur shows
# through), foreground, monospace font, white border matching Hyprland's
# general:col.active_border default (same as wofi/waybar menus), and rounded
# corners matching Hyprland's decoration.rounding.

font=monospace 11

background-color=#282a36EB
text-color=#f8f8f2FF

border-size=1
border-color=#ffffffFF
border-radius=12

progress-color=over #bd93f9FF

outer-margin=6,10,0,10
margin=10
padding=10

anchor=top-right
layer=top

default-timeout=5000

[urgency=critical]
border-size=2
border-color=#ff5555FF
